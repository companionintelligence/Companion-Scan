# Companion Scan — the API server on Node (inference, scan storage, worlds, jobs).
# Installed by scripts/install-services.sh, which substitutes __REPO__ and
# __NODE__ with absolute paths (systemd user units do not get your login PATH).
[Unit]
Description=Companion Scan API server (Node, :8000)
After=network-online.target

[Service]
WorkingDirectory=__REPO__
EnvironmentFile=%h/.config/cscan/env
# Soft gate: warn if Ollama isn't up yet, but start anyway — the engine
# degrades gracefully and /health reports engineLoadState.
ExecStartPre=-__REPO__/scripts/wait-for-url.sh ${OLLAMA_HOST}/api/tags 60 soft
ExecStart=__NODE__ server/main.ts
Restart=on-failure
RestartSec=3
SyslogIdentifier=cscan-server

[Install]
WantedBy=default.target
