<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>AuraScanner.CoreHarness</RootNamespace>
  </PropertyGroup>

  <!-- The harness compiles the Core sources the Unity project ships, not copies of them. -->
  <ItemGroup>
    <Compile Include="../../Assets/AuraScanner/Core/*.cs" Link="Core/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
